# Local pages default to http://127.0.0.1:8000.
# Cloudflare Pages: set this to the current HTTPS tunnel origin before building.
# Workers with MEETHAQ_API_ORIGIN: leave blank to use the same-origin /api proxy.
VITE_API_URL=

# Python 3.11 is the verified backend runtime; Python 3.14 is unvalidated.
# Backend variables are read from the process environment, not automatically
# loaded from this file. Set them in your shell or service configuration.
# Paths below resolve against the project root.
MEETHAQ_CHROMA_DIR=chroma_db
MEETHAQ_COLLECTION=meethaq_contracts
MEETHAQ_CALIBRATION_PATH=data/rag_calibration.json
MEETHAQ_INDEX_BATCH_SIZE=50
MEETHAQ_EMBED_TIMEOUT_SECONDS=120
MEETHAQ_OLLAMA_URL=http://127.0.0.1:11434
MEETHAQ_OLLAMA_TIMEOUT_SECONDS=180
# The backend fails closed when Ollama or llama3.2:3b is unavailable. It never
# sends contract evidence to a remote model endpoint.

# Optional Windows native runtime cache: .cache/native-runtime/dll.
# It contains signed Microsoft x64 runtime DLLs >=14.44 plus a verified manifest.
# Import the official vcRuntimeMinimum_amd64 CAB explicitly when system setup is unavailable:
# powershell -NoProfile -File ./provision_native_runtime.ps1 -CabPath C:/path/to/cab1.cab
# No environment variable is required: the backend preloads a verified project
# cache before native imports, or uses the system runtime when the cache is absent.
# Setup changes no Windows DLLs or services. Restart the backend after provisioning.
# ChromaDB 1.5.9 uses Python SegmentAPI + chroma-hnswlib 0.7.6.
# CPU ONNX model setup is explicit; the audit runtime never downloads models:
# .venv\Scripts\python.exe -B provision_onnx.py --download
# .venv\Scripts\python.exe -B provision_onnx.py --archive C:/path/to/onnx.tar.gz
# Default project cache: .cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx.
# An existing ~/.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx cache is preferred
# when it contains model.onnx. Set this optional override to choose explicitly.
# Relative overrides resolve against the project root; absolute paths also work.
# MEETHAQ_ONNX_MODEL_DIR=.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx
# Optional comma-separated custom frontend origins:
# MEETHAQ_CORS_ORIGINS=https://legal.example.com

# Set on Workers (not a Vite client variable):
# MEETHAQ_API_ORIGIN=https://your-tunnel.trycloudflare.com
