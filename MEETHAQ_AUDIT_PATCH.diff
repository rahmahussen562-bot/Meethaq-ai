+""".split())
+# Dominant cues for the complete CUAD taxonomy. Generic words such as party,
+# assignment, and license do not select a narrower, unrelated classification.
+_CUAD_TOPIC_CUES = {
+    "documentname": {"document", "name"},
+    "parties": {"party"},
+    "agreementdate": {"date"},
